# LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings (local model, no key needed, name kept here for override)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Gmail SMTP (use an app password, not your real Gmail password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres (optional for MVP — CSVs work standalone)
DATABASE_URL=

# Pipeline behavior
MATCH_THRESHOLD=70
ENABLE_LINKEDIN_SCRAPING=false
ENABLE_NAUKRI_SCRAPING=false
ENABLE_WELLFOUND_SCRAPING=false
